# Bas-URL till nginx-gatewayen i faktureringssystem-be (services/*, port
# styrs av NGINX_PORT i det repots .env, default 8080). Måste ha
# EXPO_PUBLIC_-prefixet för att Expo ska bunta in värdet i appen.
#
# - iOS-simulator:        http://localhost:8080
# - Android-emulator:     http://10.0.2.2:8080
# - Fysisk telefon (Expo Go eller dev build): din dators LAN-ip, t.ex.
#   http://192.168.1.23:8080 — telefonen och datorn måste vara på samma nät.
EXPO_PUBLIC_API_URL=http://localhost:8080
